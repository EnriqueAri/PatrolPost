import React, { useReducer, useEffect, useState, useRef } from 'react';
import {
  SafeAreaView,
  View,
  Text,
  TextInput,
  TouchableOpacity,
  FlatList,
  ScrollView,
  StyleSheet,
  KeyboardAvoidingView,
  Platform,
  Alert,
} from 'react-native';
import { StatusBar } from 'expo-status-bar';
import AsyncStorage from '@react-native-async-storage/async-storage';

/* ================= DATA / STATE ================= */

const KEY = 'patrol-post-v1';

const COOK_ROLES = [
  'Grubmaster',
  'Head Cook',
  'Assistant Cook',
  'Fire / Stove Lead',
  'Water & Dishes',
  'Cleanup Crew',
  'No role yet',
];

const RANKS = [
  'Scout',
  'Tenderfoot',
  'Second Class',
  'First Class',
  'Star',
  'Life',
  'Eagle',
];

const uid = () =>
  Math.random().toString(36).slice(2, 10) + Date.now().toString(36);

const initialState = {
  ready: false,
  patrolName: '',
  meId: null,
  members: [], // { id, name, rank }
  campouts: [], // { id, name, location, date, createdBy, rsvps: { [memberId]: Rsvp } }
  // Rsvp: { status: 'going'|'maybe'|'no', cookRole, purpose, requirements: string[] }
  messages: [], // { id, from, to, kind: 'message'|'signoff', text, requirement, status, ts, readBy: [] }
};

async function load() {
  try {
    const raw = await AsyncStorage.getItem(KEY);
    return raw ? JSON.parse(raw) : null;
  } catch (e) {
    return null;
  }
}

async function save(state) {
  try {
    const { ready, ...rest } = state;
    await AsyncStorage.setItem(KEY, JSON.stringify(rest));
  } catch (e) {
    // ignore storage errors
  }
}

function reducer(state, action) {
  switch (action.type) {
    case 'HYDRATE':
      return { ...state, ...action.data, ready: true };
    case 'READY':
      return { ...state, ready: true };

    case 'SETUP': {
      const me = { id: uid(), name: action.name.trim(), rank: action.rank };
      return {
        ...state,
        patrolName: action.patrolName.trim(),
        members: [me],
        meId: me.id,
      };
    }

    case 'ADD_MEMBER': {
      const m = { id: uid(), name: action.name.trim(), rank: action.rank };
      return { ...state, members: [...state.members, m] };
    }

    case 'SWITCH_USER':
      return { ...state, meId: action.id };

    case 'ADD_CAMPOUT': {
      const c = {
        id: uid(),
        name: action.name.trim(),
        location: action.location.trim(),
        date: (action.date || '').trim(),
        createdBy: state.meId,
        rsvps: {},
      };
      return { ...state, campouts: [c, ...state.campouts] };
    }

    case 'DELETE_CAMPOUT':
      return {
        ...state,
        campouts: state.campouts.filter((c) => c.id !== action.id),
      };

    case 'SET_RSVP':
      return {
        ...state,
        campouts: state.campouts.map((c) =>
          c.id === action.campoutId
            ? {
                ...c,
                rsvps: {
                  ...c.rsvps,
                  [state.meId]: { ...c.rsvps[state.meId], ...action.rsvp },
                },
              }
            : c
        ),
      };

    case 'SEND_MESSAGE': {
      const msg = {
        id: uid(),
        from: state.meId,
        to: action.to,
        kind: action.kind || 'message',
        text: action.text || '',
        requirement: action.requirement || '',
        status: action.kind === 'signoff' ? 'pending' : null,
        ts: Date.now(),
        readBy: [state.meId],
      };
      return { ...state, messages: [...state.messages, msg] };
    }

    case 'SIGNOFF_RESPOND':
      return {
        ...state,
        messages: state.messages.map((m) =>
          m.id === action.id ? { ...m, status: action.status } : m
        ),
      };

    case 'MARK_READ':
      return {
        ...state,
        messages: state.messages.map((m) =>
          m.to === state.meId &&
          m.from === action.withId &&
          !m.readBy.includes(state.meId)
            ? { ...m, readBy: [...m.readBy, state.meId] }
            : m
        ),
      };

    default:
      return state;
  }
}

/* ================= UI ================= */

const C = {
  green: '#2f5d3a',
  greenDark: '#1f4128',
  khaki: '#f3ecd9',
  card: '#ffffff',
  ink: '#222222',
  muted: '#6b6b6b',
  line: '#e2dcc8',
  yes: '#2e7d32',
  maybe: '#b7791f',
  no: '#b23b3b',
  accent: '#c8892b',
};

/* ---------- small shared pieces ---------- */

const Btn = ({ title, onPress, kind = 'primary', disabled, style }) => (
  <TouchableOpacity
    onPress={onPress}
    disabled={disabled}
    style={[
      s.btn,
      kind === 'secondary' && s.btnSecondary,
      kind === 'danger' && s.btnDanger,
      disabled && { opacity: 0.4 },
      style,
    ]}
  >
    <Text style={[s.btnText, kind === 'secondary' && { color: C.green }]}>
      {title}
    </Text>
  </TouchableOpacity>
);

const Chip = ({ label, selected, onPress, color }) => (
  <TouchableOpacity
    onPress={onPress}
    style={[
      s.chip,
      selected && { backgroundColor: color || C.green, borderColor: color || C.green },
    ]}
  >
    <Text style={[s.chipText, selected && { color: '#fff' }]}>{label}</Text>
  </TouchableOpacity>
);

const Field = ({ label, ...props }) => (
  <View style={{ marginBottom: 12 }}>
    {label ? <Text style={s.label}>{label}</Text> : null}
    <TextInput
      placeholderTextColor="#9a9a9a"
      style={s.input}
      {...props}
    />
  </View>
);

const Header = ({ title, onBack, right }) => (
  <View style={s.header}>
    {onBack ? (
      <TouchableOpacity onPress={onBack} style={{ paddingRight: 12 }}>
        <Text style={s.headerBack}>‹ Back</Text>
      </TouchableOpacity>
    ) : null}
    <Text style={s.headerTitle} numberOfLines={1}>
      {title}
    </Text>
    <View style={{ flex: 1 }} />
    {right}
  </View>
);

const statusColor = (st) =>
  st === 'going' ? C.yes : st === 'maybe' ? C.maybe : st === 'no' ? C.no : C.muted;
const statusLabel = (st) =>
  st === 'going' ? 'Going' : st === 'maybe' ? 'Maybe' : st === 'no' ? "Can't go" : 'No reply';

/* ---------- first-run setup ---------- */

function Setup({ dispatch }) {
  const [patrolName, setPatrolName] = useState('');
  const [name, setName] = useState('');
  const [rank, setRank] = useState('Scout');
  const ok = patrolName.trim() && name.trim();
  return (
    <ScrollView contentContainerStyle={{ padding: 20 }}>
      <Text style={s.logo}>⚜ Patrol Post</Text>
      <Text style={s.tagline}>Campouts, roles, and sign-offs for your patrol.</Text>
      <Field label="Patrol name" placeholder="e.g. Eagle Patrol" value={patrolName} onChangeText={setPatrolName} />
      <Field label="Your name" placeholder="e.g. Alex" value={name} onChangeText={setName} />
      <Text style={s.label}>Your current rank</Text>
      <View style={s.wrap}>
        {RANKS.map((r) => (
          <Chip key={r} label={r} selected={rank === r} onPress={() => setRank(r)} />
        ))}
      </View>
      <Btn
        title="Create patrol"
        disabled={!ok}
        onPress={() => dispatch({ type: 'SETUP', patrolName, name, rank })}
        style={{ marginTop: 20 }}
      />
